# ---------------------------------------------------------------- 构建中间产物
# 编译时生成：产物本身入库，中间 JSON 不入库（每次构建都会重写）
tools/_content.json
tools/_report.json

# ---------------------------------------------------------------- 验收运行产物
# 探针结果 / 截图清单 / 注入脚本副本 / 抽帧出的 JS
tools/_browser_*.json
tools/_shots.json
tools/_app.js
tools/_probe_*.js
tools/*.txt
tools/*.log

# ---------------------------------------------------------------- 无头浏览器临时目录
# 每次跑验收或截图都会新建一批，数量能到几千个、体积上 GB
tools/_prof_*/
tools/_dbp_*/
tools/_sp_*/
tools/_sgp_*/
tools/_shotwrap_*.html
tools/_probe_*-*.html
tools/_smg_*.html
tools/_dbg_pick-*.html

# 截图默认不入库（体积大）；想当视觉文档发布就删掉下面这行
tools/shot_*.png

# ---------------------------------------------------------------- 改 .md 前的备份
tools/_md_backup/

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- WorkBuddy 工作区
# 助手会话与记忆，属于本地私有内容，不发布
.workbuddy/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
